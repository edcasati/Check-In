[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/edcasati/Check-In.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "Phone-and-Watch"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/Phone-and-Watch
[branch "Phone"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/Phone
