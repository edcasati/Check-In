<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomTimePickerDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:textSize">36sp</item>
        <item name="android:gravity">center</item>
        <item name="android:numbersTextColor">@android:color/black</item>
        <item name="android:numbersBackgroundColor">@android:color/transparent</item>
        <item name="android:numbersSelectorColor">@android:color/holo_orange_light</item>
        <item name="android:paddingTop">-16dp</item>
        <item name="android:buttonBarButtonStyle">@style/TimePickerButtonStyle</item>
    </style>

    <style name="TimePickerButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">80dp</item>
        <item name="android:minHeight">45dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>
</resources> 